# Copy this file to .env and fill it in. Never commit .env.
#
# Make a Native app in your brand's dashboard (Apps → New app) with two
# redirect URIs:
#   com.example.synqlogin:/callback          where the system browser comes back
#   https://<your domain>/synq/callback      the https identity a wallet app sees
# and com.example.synqlogin:/signed-out under "After signing out". Then turn on
# "Sign in from this app's own screens", so a wallet signs in with no browser.

# Your brand's issuer, from the brand's Settings: https://<your brand>.auth.synq.build
EXPO_PUBLIC_SYNQ_ISSUER=
# The native app's client ID (app_…). A native app has no secret.
EXPO_PUBLIC_SYNQ_CLIENT_ID=
# The origin of the https redirect URI above, which the app claims with an
# Android App Link (/.well-known/assetlinks.json on that domain).
EXPO_PUBLIC_APP_ORIGIN=

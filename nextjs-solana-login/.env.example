# Copy this file to .env.local and fill it in. Never commit .env.local.
#
# Make a Web app in your brand's dashboard (Apps → New app), with
#   https://localhost:3000/api/auth/callback  as its redirect URI, and
#   https://localhost:3000/                    under "After signing out".
# Its page shows the client ID and, once, the secret.

# Your brand's issuer, from the brand's Settings: https://<your brand>.auth.synq.build
SYNQ_ISSUER=
# The app's client ID (app_…) and secret.
SYNQ_CLIENT_ID=
SYNQ_CLIENT_SECRET=
# Where this app is served. `npm run dev` serves https on port 3000.
SYNQ_APP_URL=https://localhost:3000
# At least 32 random bytes the session cookie is sealed with: openssl rand -base64 32
SYNQ_SESSION_SECRET=
